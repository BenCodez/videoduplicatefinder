@page "/results"
@rendermode InteractiveServer
@inject ScanService Scan
@inject WebSettingsService WebSettings
@inject IJSRuntime JS
@implements IDisposable
@using VDF.Core.Selection
@using VDF.Core.Cleanup

<PageTitle>Results — Video Duplicate Finder</PageTitle>

<h1>Duplicate Groups</h1>
@if (Scan.ResultsPersistenceWarning is { } resultsWarning) { <p class="aborted-msg" role="alert">@resultsWarning</p> }
@if (Scan.SelectionPersistenceWarning is { } selectionWarning) { <p class="aborted-msg" role="alert">@selectionWarning</p> }

@{
    var allDuplicates = Scan.Duplicates;
    var filteredGroups = GetFilteredGroups();
    long totalSize = 0, potentialSavings = 0;
    int totalFiles = 0;
    foreach (var g in filteredGroups) {
        long groupTotal = 0, largest = 0;
        foreach (var i in g) {
            totalFiles++;
            long s = Math.Max(0, i.SizeLong);
            groupTotal += s;
            if (s > largest) largest = s;
        }
        totalSize += groupTotal;
        potentialSavings += groupTotal - largest;
    }
    long selectedSize = _selected.Sum(i => Math.Max(0, i.SizeLong));
    int renderIndex = 0;
}

@if (!allDuplicates.Any()) {
    <p>No duplicates found. <a href="/">Run a scan</a> first.</p>
}
else {
    <div class="results-toolbar" @onkeydown="OnKeyDown" tabindex="0">
        <input class="search-box" @bind="_search" @bind:event="oninput"
               placeholder="Filter by path (* and ? wildcards)..." />
        @if (!string.IsNullOrEmpty(_search)) {
            <button @onclick="() => _search = string.Empty">&#x2715;</button>
        }
        <span class="result-count">
            @filteredGroups.Count group(s), @totalFiles file(s), @FormatSize(totalSize) — potential savings @FormatSize(potentialSavings)
            @if (_selected.Count > 0) { <text> — @_selected.Count selected (@FormatSize(selectedSize))</text> }
        </span>

        @* Auto-select dropdown *@
        <button class="primary" @onclick="() => PlanSelectionAsync()" disabled="@AutomationBusy"
                title="Use saved automation rules to select removal candidates; review before cleanup">Apply automation rules</button>
        <div class="dropdown-wrap">
            <button @onclick="() => _autoSelectOpen = !_autoSelectOpen" disabled="@AutomationBusy">Select &#x25BE;</button>
            @if (_autoSelectOpen) {
                <div class="dropdown-overlay" @onclick="() => _autoSelectOpen = false"></div>
                <div class="dropdown-menu">
                    <button @onclick="() => PlanSelectionAsync()" disabled="@AutomationBusy">Saved selection profile</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.LowestQuality)" disabled="@AutomationBusy">Lowest quality</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.SmallestFile)" disabled="@AutomationBusy">Smallest file</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.Oldest)" disabled="@AutomationBusy">Oldest (keep newest)</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.Newest)" disabled="@AutomationBusy">Newest (keep oldest)</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.HundredPercentEqual)" disabled="@AutomationBusy">100% equal groups</button>
                    <hr />
                    <button @onclick="InvertSelection">Invert selection</button>
                    <button @onclick="ClearSelection">Deselect all</button>
                </div>
            }
        </div>
        <a href="/automation">Automation settings and review</a>
        <span>When highlighted-group scope is saved, selection uses groups containing checked files.</span>

        @* Collapse all / Expand all *@
        <button @onclick="CollapseAll" title="Collapse all groups">Collapse all</button>
        <button @onclick="ExpandAll" title="Expand all groups">Expand all</button>
        <button @onclick="ExportCsv" title="Download the results list as CSV">Export CSV</button>

        @if (_selected.Count > 0) {
            <div class="action-group">
                <button @onclick="PreviewQuarantineAsync" disabled="@AutomationBusy">Preview quarantine…</button>
                <button @onclick="RemoveSelected">Remove from list</button>
                <button @onclick="() => _confirmDelete = true" class="danger-outline" disabled="@Scan.FileOpRunning">Delete (trash)</button>
                <button @onclick="() => _confirmDeletePermanent = true" class="danger" disabled="@Scan.FileOpRunning">Delete permanently</button>
                <button @onclick="() => _showMovePanel = !_showMovePanel" disabled="@Scan.FileOpRunning">Move to folder…</button>
                <button @onclick="() => _showLinkPanel = !_showLinkPanel" disabled="@Scan.FileOpRunning">Replace with links…</button>
                <button @onclick="ClearSelection">Deselect all</button>
            </div>
        }
    </div>

    @* Batch file operation progress *@
    @if (Scan.FileOpRunning) {
        <div class="action-panel">
            <span class="spinner"></span>
            <span>@Scan.FileOpVerb… @Scan.FileOpCurrent / @Scan.FileOpMax</span>
            <div class="progress-bar-track inline-bar">
                <div class="progress-bar-fill" style="width:@(Scan.FileOpMax > 0 ? 100 * Scan.FileOpCurrent / Scan.FileOpMax : 0)%"></div>
            </div>
        </div>
    }

    @if (_quarantinePreview is not null) {
        <section class="action-panel" style="display:block;overflow-wrap:anywhere;" aria-label="Quarantine preview">
            <h2>Confirm quarantine</h2>
            <p>Review @_quarantinePreview.Count target(s). The keeper stays in place. Quarantined files remain available for an explicit restore from Automation.</p>
            @foreach (var preview in _quarantinePreview) {
                <div style="margin-bottom:1rem;">
                    <p><strong>Target:</strong> @preview.Target.Path</p>
                    <p><strong>Keeper:</strong> @preview.Keeper.Path</p>
                    <p><strong>Destination directory:</strong> @preview.DestinationDirectory @(preview.DestinationWillBeCreated ? "(will be created)" : "")</p>
                    <p>@(preview.ByteIdentical ? "Byte-identical files." : "Visually similar files; bytes differ.") @preview.Reason</p>
                    <p>Sidecars left in place: @(preview.SidecarsLeftInPlace.Count == 0 ? "none" : string.Join(", ", preview.SidecarsLeftInPlace))</p>
                </div>
            }
            <button class="primary" @onclick="ConfirmQuarantineAsync" disabled="@AutomationBusy">Confirm quarantine of @_quarantinePreview.Count file(s)</button>
            <button @onclick="CancelQuarantine" disabled="@AutomationBusy">Cancel quarantine</button>
        </section>
    }

    @if (_displayPlan is not null) {
        <details class="action-panel" style="display:block;overflow-wrap:anywhere;">
            <summary>@_displayPlan.Profile selection preview — @_displayPlan.Decisions.Count decisions, @FormatSize(_displayPlan.EstimatedSavings) estimated savings</summary>
            <p>Only removal candidates are selected. File operations still require confirmation and fresh protection checks.</p>
            @foreach (var decision in _displayPlan.Decisions) {
                <p><strong>@(decision.IsProtected ? "Protected" : decision.RemoveCandidate ? "Remove candidate — review required" : decision.RequiresReview ? "Needs review" : decision.IsKeeper ? "Keep" : "Leave unchanged"):</strong> @decision.Path — @decision.Reason</p>
            }
        </details>
    }

    @* Move panel *@
    @if (_showMovePanel) {
        <div class="action-panel">
            <label>Destination folder:
                <input @bind="_moveDestination" placeholder="/path/to/destination" class="@(Directory.Exists(_moveDestination) ? "input-valid" : "")" />
            </label>
            <button class="primary" @onclick="MoveSelected" disabled="@(string.IsNullOrWhiteSpace(_moveDestination) || Scan.FileOpRunning)">Move @_selected.Count file(s)</button>
            <button @onclick="() => _showMovePanel = false">Cancel</button>
        </div>
    }

    @* Link panel *@
    @if (_showLinkPanel) {
        <div class="action-panel">
            <span>Replace each selected file with a link to the best remaining file of its group:</span>
            <label><input type="radio" name="linktype" checked="@(!_linkHard)" @onchange="() => _linkHard = false" /> Symlink</label>
            <label><input type="radio" name="linktype" checked="@_linkHard" @onchange="() => _linkHard = true" /> Hardlink (same volume only)</label>
            <button class="primary" @onclick="CreateLinksSelected" disabled="@Scan.FileOpRunning">Create links for @_selected.Count file(s)</button>
            <button @onclick="() => _showLinkPanel = false">Cancel</button>
        </div>
    }

    @* Delete confirmation *@
    @if (_confirmDelete || _confirmDeletePermanent) {
        bool perm = _confirmDeletePermanent;
        <div class="confirm-panel">
            <strong>&#x26A0; @(perm ? "Permanently delete" : "Move to trash")  @_selected.Count file(s)?</strong>
            @if (perm) { <span class="warn-text">This cannot be undone.</span> }
            <button class="danger" @onclick="() => ExecuteDelete(perm)">Confirm</button>
            <button @onclick="() => { _confirmDelete = false; _confirmDeletePermanent = false; }">Cancel</button>
        </div>
    }

    @* Operation result feedback *@
    @if (_operationMsg != null) {
        <div class="@(_operationFailed ? "error-box" : "info-box")" role="@(_operationFailed ? "alert" : "status")">@_operationMsg</div>
    }

    @foreach (var group in filteredGroups) {
        var groupId = group.Key;
        var sortedItems = SortItems(group.ToList());
        bool allGroupSelected = sortedItems.All(i => _selected.Contains(i));
        bool isCollapsed = _collapsedGroups.Contains(groupId);
        float maxSimilarity = sortedItems.Max(i => i.Similarity);
        long groupSize = sortedItems.Sum(i => Math.Max(0, i.SizeLong));
        int groupIndex = renderIndex++;
        int hiddenCount = sortedItems.Count(i => _hiddenItems.Contains(i.Path));
        var hoveredMetric = _hoveredMetrics.GetValueOrDefault(groupId);

        <div class="dup-group @(groupIndex == _focusedGroup ? "focused" : "")" @key="groupId">
            <div class="dup-group-header">
                <label class="group-select-all">
                    <input type="checkbox" checked="@allGroupSelected"
                           @onchange="() => ToggleGroup(sortedItems, !allGroupSelected)" />
                    @sortedItems.Count file(s) &#183; @FormatSize(groupSize)
                </label>
                <span class="similarity-badge @SimilarityClass(maxSimilarity)">
                    @maxSimilarity.ToString("F1")% similar
                </span>
                <div class="group-actions">
                    <select class="group-sort" title="Sort cards"
                            @onchange="e => SetGroupSort(groupId, e.Value?.ToString())">
                        <option value="" selected="@(!_groupSorts.ContainsKey(groupId))">Sort by…</option>
                        <option value="similarity">Similarity</option>
                        <option value="size">Size</option>
                        <option value="duration">Duration</option>
                        <option value="bitrate">Bitrate</option>
                        <option value="resolution">Resolution</option>
                        <option value="date">Date</option>
                        <option value="name">Name</option>
                    </select>
                    <button class="compare-btn" @onclick="() => OpenCompare(sortedItems)" title="Compare fullsize">Compare</button>
                    <button class="metadata-btn" @onclick="() => OpenMetadata(sortedItems)" title="Compare every metadata tag of these files">Metadata</button>
                    <button @onclick="() => KeepBest(sortedItems)" disabled="@AutomationBusy" title="Preview quality selection using saved protections">Keep Best</button>
                    <button class="collapse-toggle" @onclick="() => ToggleCollapse(groupId)" title="@(isCollapsed ? "Expand" : "Collapse")">
                        @(isCollapsed ? "\u25B6" : "\u25BC")
                    </button>
                </div>
            </div>

            @if (!isCollapsed) {
                <div class="dup-cards">
                    @foreach (var item in sortedItems) {
                        if (_hiddenItems.Contains(item.Path)) continue;
                        bool sel = _selected.Contains(item);
                        bool isBest = item.IsBestBitRateKbs || item.IsBestFrameSize;

                        <div class="dup-card @(isBest ? "best" : "") @(sel ? "selected" : "")"
                             @key="item.Path"
                             @onclick="() => ToggleItem(item)"
                             @oncontextmenu="e => ShowContextMenu(e, item, sortedItems)"
                             @oncontextmenu:preventDefault>

                            <div class="card-top-bar" @onclick:stopPropagation>
                                <label class="card-check">
                                    <input type="checkbox" checked="@sel"
                                           @onchange="() => ToggleItem(item)" />
                                </label>
                                <div style="display:flex;gap:0.2rem;">
                                    <a href="/automation" title="Review this file and manage durable protection">Review &amp; protect</a>
                                    <button class="card-hide" @onclick="() => HideItem(item.Path)" title="Hide card">&#x1F441;</button>
                                    <button class="card-remove" @onclick="() => RemoveSingle(item)" title="Remove from list">&#x2715;</button>
                                </div>
                            </div>

                            <div class="card-thumb" @onclick:stopPropagation>
                                @if (WebSettings.AutoLoadThumbnails) {
                                    <div class="thumb-skeleton"></div>
                                    <img data-src="@CardThumbUrl(item)"
                                         alt="thumbnail"
                                         onerror="this.style.display='none'" />
                                }
                                else {
                                    <div class="thumb-placeholder">No preview</div>
                                }
                                <span class="similarity-overlay">@item.Similarity.ToString("F1")%</span>
                            </div>

                            <div class="card-body">
                                <div class="card-filename" title="@item.Path">@System.IO.Path.GetFileName(item.Path)</div>
                                <div class="card-path" title="@item.Path">@System.IO.Path.GetDirectoryName(item.Path)</div>

                                <div class="card-meta">
                                    @if (!item.IsImage) {
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricResolution)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">Res</span>
                                            <span class="meta-value @MetaClass(item.IsBestFrameSize, hoveredMetric == MetricResolution && !item.IsBestFrameSize)">
                                                @if (hoveredMetric == MetricResolution && !item.IsBestFrameSize) {
                                                    @RelativeResolution(item, sortedItems)
                                                } else {
                                                    @(item.FrameSize ?? "?")
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricDuration)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">Dur</span>
                                            <span class="meta-value @MetaClass(item.IsBestDuration, hoveredMetric == MetricDuration && !item.IsBestDuration)">
                                                @if (hoveredMetric == MetricDuration && !item.IsBestDuration) {
                                                    @RelativeDuration(item, sortedItems)
                                                } else {
                                                    @item.Duration.ToString(@"hh\:mm\:ss")
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricBitrate)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">Bitrate</span>
                                            <span class="meta-value @MetaClass(item.IsBestBitRateKbs, hoveredMetric == MetricBitrate && !item.IsBestBitRateKbs)">
                                                @if (hoveredMetric == MetricBitrate && !item.IsBestBitRateKbs) {
                                                    @RelativePercentage(item.BitRateKbs, sortedItems.Where(i => i.IsBestBitRateKbs).Select(i => i.BitRateKbs).FirstOrDefault())
                                                } else {
                                                    @item.BitRateKbs<text> kbps</text>
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricFps)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">FPS</span>
                                            <span class="meta-value @MetaClass(item.IsBestFps, hoveredMetric == MetricFps && !item.IsBestFps)">
                                                @if (hoveredMetric == MetricFps && !item.IsBestFps) {
                                                    @RelativePercentageFloat(item.Fps, sortedItems.Where(i => i.IsBestFps).Select(i => i.Fps).FirstOrDefault())
                                                } else {
                                                    @item.Fps.ToString("F2")
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row">
                                            <span class="meta-label">Format</span>
                                            <span class="meta-value">@(item.Format ?? "?")</span>
                                        </div>
                                        @if (item.AudioLanguages.Length > 0) {
                                            <div class="meta-row">
                                                <span class="meta-label">Audio</span>
                                                <span class="meta-value">@item.AudioLanguages</span>
                                            </div>
                                        }
                                        @if (item.SubtitleLanguages.Length > 0) {
                                            <div class="meta-row">
                                                <span class="meta-label">Subs</span>
                                                <span class="meta-value">@item.SubtitleLanguages</span>
                                            </div>
                                        }
                                    }
                                    else {
                                        <div class="meta-row">
                                            <span class="meta-label">Res</span>
                                            <span class="meta-value @(item.IsBestFrameSize ? "meta-best" : "")">@(item.FrameSize ?? "?")</span>
                                        </div>
                                        <div class="meta-row">
                                            <span class="meta-label">Format</span>
                                            <span class="meta-value">@(item.Format ?? "?")</span>
                                        </div>
                                    }
                                    <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricSize)"
                                         @onmouseout="() => ClearHoveredMetric(groupId)">
                                        <span class="meta-label">Size</span>
                                        <span class="meta-value @MetaClass(item.IsBestSize, hoveredMetric == MetricSize && !item.IsBestSize)">
                                            @if (hoveredMetric == MetricSize && !item.IsBestSize) {
                                                @RelativePercentageLong(item.SizeLong, sortedItems.Where(i => i.IsBestSize).Select(i => i.SizeLong).FirstOrDefault())
                                            } else {
                                                @FormatSize(item.SizeLong)
                                            }
                                        </span>
                                    </div>
                                </div>

                                <div class="card-badges">
                                    @if (isBest) {
                                        <span class="badge-best">Best quality</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.PartialClip)) {
                                        <span class="badge-partial-clip">partial clip @item.PartialClipOffsetDisplay</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.AiMatched)) {
                                        <span class="badge-ai-matched">AI match</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.GrayscaleMatched)) {
                                        <span class="badge-partial-clip">grayscale</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.PHashMatched)) {
                                        <span class="badge-partial-clip">pHash</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (hiddenCount > 0) {
                        <div class="hidden-indicator" @onclick="() => ShowAllInGroup(sortedItems)">
                            +@hiddenCount hidden — click to show all
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@* Fullsize comparison modal *@
@if (_compareVisible && _compareItems != null && _compareItems.Count >= 2) {
    var itemA = _compareItems[_compareA];
    var itemB = _compareItems[_compareB];
    int frameCount = FramePositions.FrameCount(itemA, itemB, Scan.Settings);
    int frame = Math.Clamp(_compareFrame, 0, frameCount - 1);
    var frames = FramePositions.AlignedPair(itemA, itemB, frame, Scan.Settings);
    <div class="compare-overlay active" id="compare-modal" tabindex="0"
         @ref="_compareOverlay" @onkeydown="OnCompareKeyDown">
        <div class="compare-header">
            <h3>Compare</h3>
            <button class="compare-close" @onclick="CloseCompare" title="Close (Esc)" aria-label="Close">&#x2715;</button>
        </div>
        <div class="compare-mode-tabs">
            <button class="@(_compareMode == CompareMode.SideBySide ? "active" : "")" @onclick="() => SetCompareMode(CompareMode.SideBySide)">Side by Side</button>
            <button class="@(_compareMode == CompareMode.Swipe ? "active" : "")" @onclick="() => SetCompareMode(CompareMode.Swipe)">Swipe</button>
            @if (frameCount > 1) {
                @* The frames the scan sampled; a partial clip is lined up with its place in the source. *@
                <div class="compare-frames">
                    <button class="compare-frame-prev" disabled="@(frame == 0)"
                            @onclick="() => StepCompareFrame(-1)"
                            title="Previous frame (Left arrow)" aria-label="Previous frame">&#x25C0;</button>
                    <span class="compare-frame-count">Frame @(frame + 1) / @frameCount</span>
                    <button class="compare-frame-next" disabled="@(frame == frameCount - 1)"
                            @onclick="() => StepCompareFrame(1)"
                            title="Next frame (Right arrow)" aria-label="Next frame">&#x25B6;</button>
                </div>
            }
        </div>
        <div class="compare-selector">
            @for (int i = 0; i < _compareItems.Count; i++) {
                int idx = i;
                var ci = _compareItems[idx];
                string cls = idx == _compareA ? "active-a" : idx == _compareB ? "active-b" : "";
                <div class="compare-selector-item @cls"
                     @onclick="() => SelectCompareItem(idx)">
                    <img src="@CardThumbUrl(ci)" alt="" />
                    <div class="sel-label">@System.IO.Path.GetFileName(ci.Path)</div>
                </div>
            }
        </div>
        <div class="compare-body">
            @if (_compareMode == CompareMode.SideBySide) {
                <div class="compare-side-by-side">
                    <div class="compare-pane">
                        <div class="compare-pane-img">
                            <img src="@FullFrameUrl(itemA, frames.A)" alt="A" />
                        </div>
                        <div class="compare-pane-info">
                            <div class="compare-pane-label">@System.IO.Path.GetFileName(itemA.Path)</div>
                            <div class="compare-pane-meta">@if (!itemA.IsImage) {<span class="compare-frame-time">@FormatPosition(frames.A)</span><text> | </text>}@(itemA.FrameSize) | @FormatSize(itemA.SizeLong) | @itemA.BitRateKbs kbps</div>
                        </div>
                    </div>
                    <div class="compare-pane-divider"></div>
                    <div class="compare-pane">
                        <div class="compare-pane-img">
                            <img src="@FullFrameUrl(itemB, frames.B)" alt="B" />
                        </div>
                        <div class="compare-pane-info">
                            <div class="compare-pane-label">@System.IO.Path.GetFileName(itemB.Path)</div>
                            <div class="compare-pane-meta">@if (!itemB.IsImage) {<span class="compare-frame-time">@FormatPosition(frames.B)</span><text> | </text>}@(itemB.FrameSize) | @FormatSize(itemB.SizeLong) | @itemB.BitRateKbs kbps</div>
                        </div>
                    </div>
                </div>
            }
            else {
                <div class="compare-swipe" style="--swipe-pos: 50%">
                    <div class="compare-swipe-img-a">
                        <img src="@FullFrameUrl(itemA, frames.A)" alt="A" />
                    </div>
                    <div class="compare-swipe-img-b">
                        <img src="@FullFrameUrl(itemB, frames.B)" alt="B" />
                    </div>
                    <div class="compare-swipe-line"></div>
                    <div class="compare-swipe-handle">&#x2194;</div>
                    <span class="compare-swipe-label label-a">A@(itemA.IsImage ? "" : " " + FormatPosition(frames.A))</span>
                    <span class="compare-swipe-label label-b">B@(itemB.IsImage ? "" : " " + FormatPosition(frames.B))</span>
                </div>
            }
        </div>
    </div>
}

@* Metadata comparison modal (#926): every tag of the group's files, the odd value marked *@
@if (_metadataItems != null) {
    <div class="compare-overlay active metadata-overlay" id="metadata-modal" tabindex="0" role="dialog" aria-labelledby="metadata-title"
         @ref="_metadataOverlay" @onkeydown="OnMetadataKeyDown">
        <div class="compare-header">
            <h3 id="metadata-title">Compare metadata</h3>
            <button class="compare-close" @onclick="CloseMetadata" title="Close (Esc)" aria-label="Close">&#x2715;</button>
        </div>
        <div class="metadata-panel">
            <p class="metadata-hint">Every metadata tag of these files side by side: dates, camera, location, encoder and more. A value that most of the other files don't share is highlighted.</p>
            <div class="metadata-toolbar">
                <label><input type="checkbox" checked="@_metadataOnlyDiff" @onchange="SetMetadataOnlyDiff" /> Only show differences</label>
                @if (_metadataRows != null) {
                    <strong class="metadata-summary">@_metadataRows.Count(r => r.Differs) of @_metadataRows.Count fields differ</strong>
                }
            </div>
            @if (_metadataRows == null) {
                <p class="metadata-status">Reading metadata...</p>
            }
            else if (_metadataRows.Count == 0) {
                <p class="metadata-status">These files carry no metadata tags.</p>
            }
            else {
                var shown = _metadataRows.Where(r => !_metadataOnlyDiff || r.Differs).ToList();
                if (shown.Count == 0) {
                    <p class="metadata-status">Every tag is the same in all files. Untick "Only show differences" to see them.</p>
                }
                else {
                    <div class="metadata-scroll">
                        <table class="metadata-table">
                            <thead>
                                <tr>
                                    <th scope="col">Field</th>
                                    @for (int f = 0; f < _metadataItems.Count; f++) {
                                        var file = _metadataItems[f];
                                        bool fileSel = _selected.Contains(file);
                                        bool unavailable = _metadataUnavailable[f];
                                        <th scope="col" title="@file.Path">
                                            <label class="metadata-file">
                                                <input type="checkbox" checked="@fileSel" @onchange="() => ToggleItem(file)"
                                                       aria-label="@SelectLabel(file)" />
                                                @Path.GetFileName(file.Path)
                                            </label>
                                            @if (unavailable) {
                                                <div class="metadata-unavailable">file not available</div>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ VDF.Core.Utils.MetadataSection? section = null; }
                                @foreach (var row in shown) {
                                    if (section != row.Section) {
                                        section = row.Section;
                                        <tr class="metadata-section"><th scope="rowgroup" colspan="@(_metadataItems.Count + 1)">@SectionTitle(row.Section)</th></tr>
                                    }
                                    <tr>
                                        <th scope="row">@row.Name</th>
                                        @for (int f = 0; f < row.Values.Length; f++) {
                                            <td class="@CellClass(row, f)">
                                                @CellText(row, f)
                                                @if (row.IsOdd[f]) { <span class="visually-hidden"> (differs)</span> }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}

@* Context menu overlay + popup *@
@if (_menuVisible && _menuItem != null) {
    <div class="ctx-overlay" @onclick="HideContextMenu"></div>
    <div class="ctx-menu" style="left:@(_menuX.ToString("F0"))px;top:@(_menuY.ToString("F0"))px">
        <button @onclick="() => OpenFile(_menuItem)">Open file</button>
        <button @onclick="() => OpenFolder(_menuItem)">Open folder</button>
        <button @onclick="() => CopyPath(_menuItem)">Copy path</button>
        <hr />
        <button @onclick="() => { ToggleItem(_menuItem); HideContextMenu(); }">
            @(_selected.Contains(_menuItem) ? "Deselect" : "Select")
        </button>
        @if (_menuGroup != null) {
            bool allSel = _menuGroup.All(i => _selected.Contains(i));
            <button @onclick="() => { ToggleGroup(_menuGroup, !allSel); HideContextMenu(); }">
                @(allSel ? "Deselect group" : "Select group")
            </button>
        }
        @if (_menuGroup != null) {
            <button @onclick="() => { _ = OpenMetadata(_menuGroup); HideContextMenu(); }">Compare metadata</button>
        }
        <hr />
        <button @onclick="() => { HideItem(_menuItem.Path); HideContextMenu(); }">Hide card</button>
        <button @onclick="() => RemoveSingle(_menuItem)">Remove from list</button>
    </div>
}

@code {
    string _search = string.Empty;
    readonly HashSet<DuplicateItem> _selected = new();
    readonly HashSet<DuplicateItem> _selectedByPlan = new();
    bool _confirmDelete;
    bool _confirmDeletePermanent;
    bool _showMovePanel;
    bool _showLinkPanel;
    bool _linkHard;
    string _moveDestination = string.Empty;
    string? _operationMsg;
    bool _operationFailed;
    bool _automationWorking;
    bool _disposed;
    int _messageGeneration;
    SelectionPlan? _lastAppliedPlan;
    SelectionPlan? _displayPlan;
    IReadOnlyList<QuarantinePreview>? _quarantinePreview;
    List<DuplicateItem> _quarantineItems = new();
    bool AutomationBusy => _automationWorking || Scan.IsBusy;

    // Context menu
    bool _menuVisible;
    double _menuX, _menuY;
    DuplicateItem? _menuItem;
    List<DuplicateItem>? _menuGroup;

    // Auto-select dropdown
    bool _autoSelectOpen;

    // QoL state
    readonly HashSet<Guid> _collapsedGroups = new();
    readonly HashSet<string> _hiddenItems = new();
    readonly Dictionary<Guid, string> _hoveredMetrics = new();
    readonly Dictionary<Guid, string> _groupSorts = new();
    int _focusedGroup = -1;

    // Comparison modal
    bool _compareVisible;
    List<DuplicateItem>? _compareItems;
    int _compareA;
    int _compareB = 1;
    CompareMode _compareMode = CompareMode.SideBySide;
    bool _compareSelectingB;
    int _compareFrame;
    ElementReference _compareOverlay;
    bool _focusCompare;

    enum CompareMode { SideBySide, Swipe }

    // Metric name constants (avoid escaped quotes in Razor attributes)
    const string MetricResolution = "resolution";
    const string MetricDuration = "duration";
    const string MetricBitrate = "bitrate";
    const string MetricFps = "fps";
    const string MetricSize = "size";

    enum AutoSelectMode { LowestQuality, SmallestFile, Oldest, Newest, HundredPercentEqual }

    protected override void OnInitialized() {
        Scan.StateChanged += OnStateChanged;
        SyncSelectionPlan();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        try {
            if (firstRender && !_compareModeLoaded) {
                _compareModeLoaded = true;
                var saved = await JS.InvokeAsync<string>("vdf.getCompareMode");
                if (Enum.TryParse<CompareMode>(saved, out var parsed)) {
                    _compareMode = parsed;
                    StateHasChanged();
                }
            }
            await JS.InvokeVoidAsync("vdf.initLazyThumbs");
            if (_metadataItems != null && _focusMetadata) {
                // Esc is handled on the overlay, which only hears it with focus.
                _focusMetadata = false;
                await _metadataOverlay.FocusAsync();
            }
            if (_compareVisible && _focusCompare) {
                // The arrow keys and Esc are handled on the overlay, which only hears them with focus.
                _focusCompare = false;
                await _compareOverlay.FocusAsync();
            }
            if (_compareVisible && _compareMode == CompareMode.Swipe)
                await JS.InvokeVoidAsync("vdf.initSwipe");
        }
        catch { }
    }

    void OnStateChanged() {
        try { _ = InvokeAsync(() => {
            if (_disposed) return;
            SyncSelectionPlan();
            StateHasChanged();
        }); }
        catch { }
    }

    void SyncSelectionPlan() {
        _selected.IntersectWith(Scan.Duplicates);
        _selectedByPlan.IntersectWith(Scan.Duplicates);
        if (_automationWorking || Scan.IsBusy) return;
        if (Scan.LastSelectionPlan is not { } plan) {
            // A new Keep/protection or configuration change invalidates an old
            // automatic plan. Preserve deliberate checkbox edits, while clearing
            // candidates that still came solely from that invalidated plan.
            if (_selected.RemoveWhere(item => _selectedByPlan.Contains(item)) > 0) CancelQuarantine();
            _selectedByPlan.Clear();
            _lastAppliedPlan = null;
            _displayPlan = null;
            return;
        }
        if (ReferenceEquals(plan, _lastAppliedPlan)) return;
        ApplySelectionPlan(plan, plan.Decisions.Select(decision => decision.GroupId).ToHashSet());
    }

    void ApplySelectionPlan(SelectionPlan plan, HashSet<Guid>? scope) {
        CancelQuarantine();
        if (scope is null) {
            _selected.Clear();
            _selectedByPlan.Clear();
        }
        else {
            _selected.RemoveWhere(item => scope.Contains(item.GroupId));
            _selectedByPlan.RemoveWhere(item => scope.Contains(item.GroupId));
        }
        var paths = plan.Decisions.Where(decision => decision.RemoveCandidate && !decision.IsProtected)
            .Select(decision => decision.Path).ToHashSet(VDF.Core.Utils.PathComparer.ForCurrentPlatform);
        foreach (var item in Scan.Duplicates.Where(item => paths.Contains(item.Path))) {
            _selected.Add(item);
            _selectedByPlan.Add(item);
        }
        _lastAppliedPlan = plan;
        _displayPlan = plan;
    }

    // === Selection ===
    void ToggleItem(DuplicateItem item) {
        if (_automationWorking) return;
        CancelQuarantine();
        _selectedByPlan.Remove(item);
        if (!_selected.Remove(item))
            _selected.Add(item);
    }

    void ToggleGroup(IEnumerable<DuplicateItem> items, bool select) {
        if (_automationWorking) return;
        CancelQuarantine();
        foreach (var item in items) {
            _selectedByPlan.Remove(item);
            if (select) _selected.Add(item);
            else _selected.Remove(item);
        }
    }

    void InvertSelection() {
        if (_automationWorking) return;
        CancelQuarantine();
        _selectedByPlan.Clear();
        _autoSelectOpen = false;
        foreach (var item in Scan.Duplicates.ToList()) {
            if (!_selected.Remove(item))
                _selected.Add(item);
        }
    }

    void ClearSelection() {
        if (_automationWorking) return;
        CancelQuarantine();
        _selectedByPlan.Clear();
        _autoSelectOpen = false;
        _selected.Clear();
    }

    // === Remove / Delete / Move ===
    async Task RemoveSelected() {
        CancelQuarantine();
        try {
            await Scan.RemoveFromResultsAsync(_selected.ToList());
            _selected.Clear();
            ShowMsg("Removed from results list.", false);
        }
        catch (Exception ex) { ShowMsg("Removing results failed: " + ex.Message, true); }
    }

    async Task RemoveSingle(DuplicateItem item) {
        CancelQuarantine();
        HideContextMenu();
        try { await Scan.RemoveFromResultsAsync([item]); _selected.Remove(item); }
        catch (Exception ex) { ShowMsg("Removing result failed: " + ex.Message, true); }
    }

    async Task ExecuteDelete(bool permanent) {
        CancelQuarantine();
        _confirmDelete = false;
        _confirmDeletePermanent = false;
        var toDelete = _selected.ToList();
        _selected.Clear();
        var result = await Scan.DeleteItemsAsync(toDelete, permanent);
        ShowOpResult($"{result.Done} file(s) {(permanent ? "permanently deleted" : "moved to trash")}", result);
    }

    async Task MoveSelected() {
        CancelQuarantine();
        _showMovePanel = false;
        var toMove = _selected.ToList();
        _selected.Clear();
        var result = await Scan.MoveItemsAsync(toMove, _moveDestination);
        ShowOpResult($"{result.Done} file(s) moved to '{_moveDestination}'", result);
    }

    async Task CreateLinksSelected() {
        CancelQuarantine();
        _showLinkPanel = false;
        var toLink = _selected.ToList();
        _selected.Clear();
        var result = await Scan.CreateLinksAsync(toLink, _linkHard);
        ShowOpResult($"{result.Done} file(s) replaced with {(_linkHard ? "hardlinks" : "symlinks")}", result);
    }

    void ShowOpResult(string action, FileOpResult result) {
        string msg = action;
        if (result.FreedBytes > 0) msg += $" — {FormatSize(result.FreedBytes)} freed";
        msg += ".";
        if (result.Failed > 0) msg += $" {result.Failed} failed: {string.Join("; ", result.Errors.Take(3))}";
        else if (result.Errors.Count > 0) msg += $" {string.Join("; ", result.Errors.Take(3))}";
        ShowMsg(msg, result.Failed > 0 || result.Errors.Count > 0);
    }

    void ShowMsg(string msg, bool failed) {
        int generation = ++_messageGeneration;
        _operationMsg = msg;
        _operationFailed = failed;
        if (failed) return;
        _ = Task.Delay(5000).ContinueWith(_ => InvokeAsync(() => {
            if (_disposed || generation != _messageGeneration) return;
            _operationMsg = null;
            StateHasChanged();
        }));
    }

    // === Context Menu ===
    void ShowContextMenu(MouseEventArgs e, DuplicateItem item, List<DuplicateItem> group) {
        _menuItem = item;
        _menuGroup = group;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuVisible = true;
        _autoSelectOpen = false;
    }

    void HideContextMenu() {
        _menuVisible = false;
        _menuItem = null;
        _menuGroup = null;
    }

    void OpenFile(DuplicateItem item) {
        HideContextMenu();
        try {
            System.Diagnostics.Process.Start(
                new System.Diagnostics.ProcessStartInfo(item.Path) { UseShellExecute = true });
        }
        catch { }
    }

    void OpenFolder(DuplicateItem item) {
        HideContextMenu();
        try {
            var dir = Path.GetDirectoryName(item.Path);
            if (dir != null)
                System.Diagnostics.Process.Start(
                    new System.Diagnostics.ProcessStartInfo(dir) { UseShellExecute = true });
        }
        catch { }
    }

    async Task CopyPath(DuplicateItem item) {
        HideContextMenu();
        try { await JS.InvokeVoidAsync("vdf.copyToClipboard", item.Path); }
        catch { }
    }

    // === QoL: Collapse / Expand ===
    void ToggleCollapse(Guid groupId) {
        if (!_collapsedGroups.Remove(groupId))
            _collapsedGroups.Add(groupId);
    }

    void CollapseAll() {
        foreach (var g in Scan.Duplicates.Select(d => d.GroupId).Distinct())
            _collapsedGroups.Add(g);
    }

    void ExpandAll() => _collapsedGroups.Clear();

    // === QoL: Hide Cards ===
    void HideItem(string path) => _hiddenItems.Add(path);

    void ShowAllInGroup(List<DuplicateItem> items) {
        foreach (var item in items)
            _hiddenItems.Remove(item.Path);
    }

    // === QoL: Fullsize Compare ===
    bool _compareModeLoaded;
    void OpenCompare(List<DuplicateItem> items) {
        if (items.Count < 2) return;
        _compareItems = items;
        _compareA = 0;
        _compareB = Math.Min(1, items.Count - 1);
        _compareSelectingB = false;
        _compareFrame = FramePositions.MiddleFrame(CompareFrameCount());
        _compareVisible = true;
        _focusCompare = true;
    }

    int CompareFrameCount() =>
        _compareItems == null ? 1 : FramePositions.FrameCount(_compareItems[_compareA], _compareItems[_compareB], Scan.Settings);

    void StepCompareFrame(int delta) =>
        _compareFrame = Math.Clamp(_compareFrame + delta, 0, CompareFrameCount() - 1);

    void OnCompareKeyDown(KeyboardEventArgs e) {
        switch (e.Key) {
            case "ArrowLeft": StepCompareFrame(-1); break;
            case "ArrowRight": StepCompareFrame(1); break;
            case "Escape": CloseCompare(); break;
        }
    }

    // Built in code: Razor does not decode "&amp;" inside an attribute that mixes text and
    // expressions, so a URL written into the markup asked for "amp;w", "amp;q" and "amp;t",
    // which the server does not know, and got the defaults instead.
    string CardThumbUrl(DuplicateItem item) =>
        "/thumbnail/hq?path=" + Uri.EscapeDataString(item.Path) +
        "&w=" + WebSettings.ThumbnailWidth + "&q=" + WebSettings.ThumbnailJpegQuality +
        "&t=" + FramePositions.ToQueryValue(FramePositions.DefaultTimestamp(item, Scan.Settings));

    static string FullFrameUrl(DuplicateItem item, TimeSpan at) =>
        "/thumbnail/full?path=" + Uri.EscapeDataString(item.Path) + "&t=" + FramePositions.ToQueryValue(at);

    static string FormatPosition(TimeSpan at) => at.ToString(@"hh\:mm\:ss");

    void SetCompareMode(CompareMode mode) {
        _compareMode = mode;
        _ = JS.InvokeVoidAsync("vdf.setCompareMode", mode.ToString());
    }

    void CloseCompare() => _compareVisible = false;

    // === Metadata comparison (#926): read when opened, never stored ===
    List<DuplicateItem>? _metadataItems;
    List<VDF.Core.Utils.MetadataComparisonRow>? _metadataRows;
    bool[] _metadataUnavailable = Array.Empty<bool>();
    bool _metadataOnlyDiff = true;
    ElementReference _metadataOverlay;
    bool _focusMetadata;
    int _metadataRequest;

    async Task OpenMetadata(List<DuplicateItem> items) {
        var files = items.ToList();
        int request = ++_metadataRequest;
        _metadataItems = files;
        _metadataRows = null;
        _metadataUnavailable = new bool[files.Count];
        _metadataOnlyDiff = true;
        _focusMetadata = true;
        StateHasChanged();
        var results = await MetadataLookup.ReadAllAsync(files.Select(i => i.Path).ToList());
        if (request != _metadataRequest) return; // closed or replaced meanwhile
        _metadataUnavailable = results.Select(r => r == null).ToArray();
        _metadataRows = VDF.Core.Utils.MetadataComparison.Build(results);
        await InvokeAsync(StateHasChanged);
    }

    void CloseMetadata() {
        _metadataItems = null;
        _metadataRows = null;
        _metadataRequest++;
    }

    void SetMetadataOnlyDiff(ChangeEventArgs e) => _metadataOnlyDiff = e.Value is true;

    void OnMetadataKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Escape") CloseMetadata();
    }

    static string SelectLabel(DuplicateItem item) => "Select " + Path.GetFileName(item.Path);

    static string CellClass(VDF.Core.Utils.MetadataComparisonRow row, int f) =>
        (row.IsOdd[f] ? "metadata-odd " : string.Empty) + (row.Values[f] == null ? "metadata-missing" : string.Empty);

    string CellText(VDF.Core.Utils.MetadataComparisonRow row, int f) =>
        _metadataUnavailable[f] ? "file not available" : row.Values[f] ?? "(not set)";

    static string SectionTitle(VDF.Core.Utils.MetadataSection section) => section.Kind switch {
        VDF.Core.Utils.MetadataSectionKind.Container => "Container",
        VDF.Core.Utils.MetadataSectionKind.Stream => "Stream " + section.StreamIndex + ": " + section.StreamType,
        VDF.Core.Utils.MetadataSectionKind.Exif => "EXIF",
        _ => "GPS",
    };

    async Task InitSwipeIfNeeded() {
        if (_compareMode == CompareMode.Swipe)
            await JS.InvokeVoidAsync("vdf.initSwipe");
    }

    void SelectCompareItem(int idx) {
        int framesBefore = CompareFrameCount();
        if (_compareSelectingB) {
            _compareB = idx;
        }
        else {
            _compareA = idx;
        }
        _compareSelectingB = !_compareSelectingB;
        // A partial clip steps through other frames than a plain duplicate: start over in the middle.
        int framesNow = CompareFrameCount();
        if (framesNow != framesBefore)
            _compareFrame = FramePositions.MiddleFrame(framesNow);
    }

    // === QoL: Keep Best ===
    Task KeepBest(List<DuplicateItem> items) => PlanSelectionAsync(SelectionProfile.QualityFirst, items.Select(item => item.GroupId).ToHashSet());

    // === QoL: Sort Within Group ===
    void SetGroupSort(Guid groupId, string? sort) {
        if (string.IsNullOrEmpty(sort))
            _groupSorts.Remove(groupId);
        else
            _groupSorts[groupId] = sort;
    }

    List<DuplicateItem> SortItems(List<DuplicateItem> items) {
        if (items.Count == 0) return items;
        var groupId = items[0].GroupId;
        if (!_groupSorts.TryGetValue(groupId, out var sort))
            return items.OrderByDescending(i => i.Similarity).ToList();

        return sort switch {
            "similarity" => items.OrderByDescending(i => i.Similarity).ToList(),
            "size" => items.OrderByDescending(i => i.SizeLong).ToList(),
            "duration" => items.OrderByDescending(i => i.Duration).ToList(),
            "bitrate" => items.OrderByDescending(i => i.BitRateKbs).ToList(),
            "resolution" => items.OrderByDescending(i => i.FrameSizeInt).ToList(),
            "date" => items.OrderByDescending(i => i.DateCreated).ToList(),
            "name" => items.OrderBy(i => System.IO.Path.GetFileName(i.Path)).ToList(),
            _ => items.OrderByDescending(i => i.Similarity).ToList()
        };
    }

    // === QoL: Hover-to-Compare ===
    void SetHoveredMetric(Guid groupId, string metric) => _hoveredMetrics[groupId] = metric;
    void ClearHoveredMetric(Guid groupId) => _hoveredMetrics.Remove(groupId);

    string RelativeDuration(DuplicateItem item, List<DuplicateItem> group) {
        var best = group.Where(i => i.IsBestDuration).Select(i => i.Duration).FirstOrDefault();
        if (best == TimeSpan.Zero) best = group.Max(i => i.Duration);
        var diff = item.Duration - best;
        if (Math.Abs(diff.TotalSeconds) < 1) return "=";
        string sign = diff < TimeSpan.Zero ? "-" : "+";
        var abs = diff < TimeSpan.Zero ? -diff : diff;
        if (abs.TotalHours >= 1) return $"{sign}{abs:h\\hm\\mss\\s}";
        if (abs.TotalMinutes >= 1) return $"{sign}{abs:m\\mss\\s}";
        return $"{sign}{abs.TotalSeconds:F0}s";
    }

    string RelativeResolution(DuplicateItem item, List<DuplicateItem> group) {
        int bestPixels = group.Where(i => i.IsBestFrameSize).Select(i => i.FrameSizeInt).FirstOrDefault();
        if (bestPixels == 0) bestPixels = group.Max(i => i.FrameSizeInt);
        if (bestPixels == 0) return "?";
        if (item.FrameSizeInt == bestPixels) return "=";
        double pct = (double)(item.FrameSizeInt - bestPixels) / bestPixels * 100;
        return $"{pct:+0;-0}%";
    }

    string RelativePercentage(decimal value, decimal best) {
        if (best == 0) return "?";
        if (value == best) return "=";
        double pct = (double)(value - best) / (double)best * 100;
        return $"{pct:+0;-0}%";
    }

    string RelativePercentageFloat(float value, float best) {
        if (best == 0) return "?";
        if (Math.Abs(value - best) < 0.01f) return "=";
        double pct = (value - best) / best * 100;
        return $"{pct:+0;-0}%";
    }

    string RelativePercentageLong(long value, long best) {
        if (best == 0) return "?";
        if (value == best) return "=";
        double pct = (double)(value - best) / best * 100;
        return $"{pct:+0;-0}%";
    }

    string MetaClass(bool isBest, bool showDelta) {
        if (isBest) return "meta-best";
        if (showDelta) return "meta-delta";
        return "";
    }

    static string SimilarityClass(float sim) => sim >= 99f ? "high" : sim >= 90f ? "medium" : "low";

    // === Filtering ===
    List<IGrouping<Guid, DuplicateItem>> GetFilteredGroups() =>
        Scan.Duplicates
            .GroupBy(d => d.GroupId)
            .Where(g => string.IsNullOrEmpty(_search) || g.Any(i => PathMatchesFilter(i.Path, _search)))
            .OrderBy(g => g.Key)
            .ToList();

    // Substring match by default; * and ? switch to wildcard matching (same rules as the GUI filter).
    // Backslashes are escaped because MatchesSimpleExpression treats '\' in the pattern as an
    // escape character - raw Windows paths would never match (#864).
    static bool PathMatchesFilter(string path, string needle) {
        if (needle.IndexOfAny(['*', '?']) < 0)
            return path.Contains(needle, StringComparison.OrdinalIgnoreCase);
        string pattern = needle.Replace("\\", "\\\\");
        if (!pattern.StartsWith('*')) pattern = "*" + pattern;
        if (!pattern.EndsWith('*')) pattern += "*";
        return System.IO.Enumeration.FileSystemName.MatchesSimpleExpression(pattern, path);
    }

    // === CSV Export ===
    // Built here rather than by an endpoint: the selection belongs to this circuit, and
    // ScanService is shared by every open tab.
    async Task ExportCsv() {
        try {
            byte[] csv = ResultsCsv.Build(Scan.Duplicates.ToList(), _selected);
            using var stream = new MemoryStream(csv);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("vdf.downloadStream", ResultsCsv.FileName, streamRef);
        }
        catch { }
    }

    // === QoL: Keyboard Navigation ===
    async Task OnKeyDown(KeyboardEventArgs e) {
        // Same group list the page renders, so j/k/x/1-9 act on what the user sees.
        var groups = GetFilteredGroups();
        if (groups.Count == 0) return;

        switch (e.Key) {
            case "j" or "J":
                _focusedGroup = Math.Min(_focusedGroup + 1, groups.Count - 1);
                await JS.InvokeVoidAsync("vdf.scrollToGroup", _focusedGroup);
                break;
            case "k" or "K":
                _focusedGroup = Math.Max(_focusedGroup - 1, 0);
                await JS.InvokeVoidAsync("vdf.scrollToGroup", _focusedGroup);
                break;
            case "x" or "X":
                if (_focusedGroup >= 0 && _focusedGroup < groups.Count) {
                    var items = groups[_focusedGroup].ToList();
                    await KeepBest(items);
                }
                break;
            case "h" or "H":
                // Hide/show card — would need card focus tracking, skip for now
                break;
            default:
                if (int.TryParse(e.Key, out int num) && num >= 1 && num <= 9) {
                    if (_focusedGroup >= 0 && _focusedGroup < groups.Count) {
                        var items = groups[_focusedGroup].ToList();
                        if (num <= items.Count)
                            ToggleItem(items[num - 1]);
                    }
                }
                break;
        }
    }

    // === Selection planning and quarantine ===
    async Task PlanSelectionAsync(SelectionProfile? profile = null, HashSet<Guid>? explicitScope = null) {
        _autoSelectOpen = false;
        if (_automationWorking) return;
        _automationWorking = true;
        CancelQuarantine();
        try {
            if (Scan.IsBusy) throw new InvalidOperationException("Wait for the current scan or operation to finish.");
            var (plan, scope) = await Scan.PreviewResultsSelectionAsync(profile, explicitScope,
                _selected.Select(item => item.GroupId).ToHashSet());
            ApplySelectionPlan(plan, scope);
            ShowMsg($"Selection preview prepared: {_selected.Count} removal candidate(s) selected. Review the explanations before cleanup.", false);
        }
        catch (Exception ex) { ShowMsg("Selection preview failed: " + ex.Message, true); }
        finally {
            _automationWorking = false;
            SyncSelectionPlan();
        }
    }

    async Task AutoSelect(AutoSelectMode mode) {
        if (mode is AutoSelectMode.LowestQuality or AutoSelectMode.Oldest or AutoSelectMode.Newest) {
            await PlanSelectionAsync(mode switch {
                AutoSelectMode.LowestQuality => SelectionProfile.QualityFirst,
                AutoSelectMode.Oldest => SelectionProfile.NewestFirst,
                _ => SelectionProfile.OldestFirst
            });
            return;
        }
        _autoSelectOpen = false;
        if (_automationWorking) return;
        _automationWorking = true;
        CancelQuarantine();
        try {
            if (Scan.IsBusy) throw new InvalidOperationException("Wait for the current scan or operation to finish.");
            var config = await Scan.LoadAutomationAsync();
            var scope = config.Selection.HighlightedGroupsOnly ? _selected.Select(item => item.GroupId).ToHashSet() : null;
            if (scope is { Count: 0 }) throw new InvalidOperationException("Select a file to highlight its group first.");
            var reviewRows = await Scan.GetReviewRowsAsync();
            var protectedPaths = reviewRows.Where(row => row.IsProtected || row.Choice is ReviewChoice.Keep or ReviewChoice.Ignore or ReviewChoice.RejectGroup)
                .Select(row => row.Item.Path).ToHashSet(VDF.Core.Utils.PathComparer.ForCurrentPlatform);
            var rejectedGroups = reviewRows.Where(row => row.Choice is ReviewChoice.Ignore or ReviewChoice.RejectGroup).Select(row => row.Item.GroupId).ToHashSet();
            foreach (var group in Scan.Duplicates.GroupBy(item => item.GroupId).Where(group =>
                (scope is null || scope.Contains(group.Key)) && !rejectedGroups.Contains(group.Key))) {
                var items = group.OrderBy(item => item.Path, VDF.Core.Utils.PathComparer.ForCurrentPlatform).ToList();
                if (items.Count < 2) continue;
                if (mode == AutoSelectMode.HundredPercentEqual && items.Any(item => item.Similarity < 100f)) continue;
                var keeper = mode == AutoSelectMode.SmallestFile ? items.OrderByDescending(item => item.SizeLong).First() : items[0];
                foreach (var item in items)
                    if (!ReferenceEquals(item, keeper) && !protectedPaths.Contains(item.Path)) _selected.Add(item);
            }
            ShowMsg("Selection updated. Protected files and rejected groups were preserved; cleanup verifies protections again.", false);
        }
        catch (Exception ex) { ShowMsg("Selection failed: " + ex.Message, true); }
        finally { _automationWorking = false; }
    }

    async Task PreviewQuarantineAsync() {
        if (_automationWorking) return;
        _automationWorking = true;
        CancelQuarantine();
        try {
            if (Scan.IsBusy) throw new InvalidOperationException("Wait for the current scan or operation to finish.");
            var selected = _selected.ToList();
            if (selected.Count == 0) throw new InvalidOperationException("Select at least one removal candidate first.");
            var preview = await Scan.PreviewQuarantineAsync(selected);
            if (!_selected.SetEquals(selected)) throw new InvalidOperationException("Selection changed. Preview quarantine again.");
            if (preview.Count != selected.Count) throw new InvalidOperationException("The preview does not include every selected file. Review the selection and preview again.");
            _quarantineItems = selected;
            _quarantinePreview = preview;
            _operationMsg = null;
            _messageGeneration++;
        }
        catch (Exception ex) { ShowMsg("Quarantine preview failed: " + ex.Message, true); }
        finally { _automationWorking = false; }
    }

    async Task ConfirmQuarantineAsync() {
        if (_automationWorking) return;
        _automationWorking = true;
        try {
            if (Scan.IsBusy) throw new InvalidOperationException("Wait for the current scan or operation to finish.");
            if (_quarantinePreview is null || _quarantineItems.Count == 0 || !_selected.SetEquals(_quarantineItems))
                throw new InvalidOperationException("Selection changed. Preview quarantine again before confirming.");
            var items = _quarantineItems.ToList();
            CancelQuarantine();
            var result = await Scan.QuarantineItemsAsync(items);
            _selected.IntersectWith(Scan.Duplicates);
            _displayPlan = null;
            ShowOpResult($"{result.Done} file(s) quarantined", result);
        }
        catch (Exception ex) {
            CancelQuarantine();
            ShowMsg("Quarantine failed: " + ex.Message, true);
        }
        finally { _automationWorking = false; }
    }

    void CancelQuarantine() {
        _quarantinePreview = null;
        _quarantineItems = new();
    }

    static string FormatSize(long bytes) {
        if (bytes < 0) return "?";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    public void Dispose() {
        _disposed = true;
        Scan.StateChanged -= OnStateChanged;
    }
}
